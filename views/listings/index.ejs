<%- layout("/layouts/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1rem 0;
        border-bottom: 1px solid #ddd;
    }

    .filter {
        text-align: center;
        min-width: 70px;
        opacity: 0.7;
        text-decoration: none;
        color: inherit;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .filter:hover {
        opacity: 1;
        transform: translateY(-2px);
    }

    .filter.active {
        opacity: 1;
        border-bottom: 2px solid #222;
    }

    .filter i {
        font-size: 1.5rem;
    }

    .filter p {
        font-size: 0.8rem;
        margin-top: 0.5rem;
        margin-bottom: 0;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle,
    .dark-theme {
        display: flex;
        align-items: center;
        border: 1px solid #222;
        border-radius: 1rem;
        min-height: 3.5rem;
        padding: 0.75rem 1rem;
    }

    .tax-toggle .form-check,
    .dark-theme .form-check {
        margin: 0;
        white-space: nowrap;
    }

    .listing-link {
        text-decoration: none;
        color: inherit;
    }

    .listing-card {
        border: none;
        margin-bottom: 1rem;
        transition: opacity 0.2s ease;
    }

    .listing-card:hover {
        opacity: 0.9;
    }

    .listing-card img {
        border-radius: 1rem;
        width: 100%;
        object-fit: cover;
    }

    .listing-card .card-body {
        padding: 0.75rem 0;
    }

    .empty-category {
        width: 100%;
        padding: 4rem 1rem;
        text-align: center;
    }

    body.dark-mode {
        background-color: #181818;
        color: #f5f5f5;
    }

    body.dark-mode .filter {
        color: #f5f5f5;
    }

    body.dark-mode .filter.active {
        border-bottom-color: #f5f5f5;
    }

    body.dark-mode #filters {
        border-bottom-color: #555;
    }

    body.dark-mode .tax-toggle,
    body.dark-mode .dark-theme {
        border-color: #aaa;
    }

    body.dark-mode .listing-card {
        background-color: #242424;
        color: #f5f5f5;
    }

    body.dark-mode .btn-outline-dark {
        color: #f5f5f5;
        border-color: #f5f5f5;
    }

    @media (max-width: 768px) {
        #filters {
            justify-content: flex-start;
            gap: 1rem;
        }

        .filter {
            min-width: 60px;
        }

        .tax-toggle,
        .dark-theme {
            min-height: 2.8rem;
            padding: 0.5rem;
        }
    }
</style>

<!-- Categories -->

<div id="filters">

    <a href="/listings" class="filter">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </a>

    <a href="/listings/category/Rooms" class="filter">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </a>

    <a href="/listings/category/Iconic%20Cities" class="filter">
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic Cities</p>
    </a>

    <a href="/listings/category/Mountains" class="filter">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
    </a>

    <a href="/listings/category/Castles" class="filter">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
    </a>

    <a href="/listings/category/Amazing%20Pools" class="filter">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Amazing Pools</p>
    </a>

    <a href="/listings/category/Camping" class="filter">
        <i class="fa-solid fa-tents"></i>
        <p>Camping</p>
    </a>

    <a href="/listings/category/Farms" class="filter">
        <i class="fa-solid fa-cow"></i>
        <p>Farms</p>
    </a>

    <a href="/listings/category/Arctic" class="filter">
        <i class="fa-solid fa-snowman"></i>
        <p>Arctic</p>
    </a>

    <div class="tax-toggle">
        <div class="form-check form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="switchCheckDefault"
            >
            <label class="form-check-label" for="switchCheckDefault">
                Add Taxes
            </label>
        </div>
    </div>

    <div class="dark-theme">
        <div class="form-check form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="switchCheckDefault1"
            >
            <label class="form-check-label" for="switchCheckDefault1">
                Dark
            </label>
        </div>
    </div>

</div>

<!-- All Listings -->

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">

    <% if (allListing && allListing.length > 0) { %>

        <% for (let listing of allListing) { %>

            <div class="col">

                <a
                    href="/listings/<%= listing._id %>"
                    class="listing-link"
                >

                    <div class="card listing-card">

                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            alt="<%= listing.title %>"
                            style="height: 20rem;"
                        >

                        <div class="card-img-overlay"></div>

                        <div class="card-body">

                            <p class="card-text">
                                <b><%= listing.title %></b>
                                <br>

                                &#8377;
                                <%= listing.price.toLocaleString("en-IN") %>
                                /Night

                                <i class="tax-info"> +18% GST</i>
                            </p>

                        </div>

                    </div>

                </a>

            </div>

        <% } %>

    <% } else { %>

        <div class="empty-category">

            <h4>No listings found in this category.</h4>

            <p>
                There are currently no listings matching this category.
            </p>

            <a href="/listings" class="btn btn-dark mt-2">
                Explore All Listings
            </a>

        </div>

    <% } %>

</div>

<script>
    // Add Taxes toggle
    const taxSwitch = document.getElementById("switchCheckDefault");
    const taxInfo = document.querySelectorAll(".tax-info");

    taxSwitch.addEventListener("change", () => {
        taxInfo.forEach((info) => {
            info.style.display = taxSwitch.checked ? "inline" : "none";
        });
    });

    // Dark Mode toggle
    const darkSwitch = document.getElementById("switchCheckDefault1");

    darkSwitch.addEventListener("change", () => {
        document.body.classList.toggle("dark-mode", darkSwitch.checked);
    });

    // Highlight the selected category
    const currentPath = decodeURIComponent(window.location.pathname);
    const filters = document.querySelectorAll("#filters .filter");

    filters.forEach((filter) => {
        const linkPath = decodeURIComponent(
            new URL(filter.href, window.location.origin).pathname
        );

        if (linkPath === currentPath) {
            filter.classList.add("active");
        }
    });
</script>